# env.local.sh -- machine-specific settings, read by env.sh.
#
#   cp env.local.sh.example env.local.sh      # then edit; env.local.sh is gitignored
#
# Every line is optional. Replace the <...> placeholders with your own values,
# or delete a line to keep the default shown in the comment.

# SpaceHub headers, if not cloned into external/SpaceHub (default: <repo>/external/SpaceHub/src)
# export SPACEHUB="</path/to/SpaceHub/src>"

# Where campaign run directories, joblists, results and logs go (default: <repo>/scratch).
# On a cluster, point this at your scratch file system, e.g. /scratch/<your-username>.
# export SMBH_SCRATCH="</path/to/your/scratch>"

# Large data from Zenodo (default: <repo>/data)
# export SMBH_DATA="</path/to/data>"

# ---- SLURM (only for the campaigns/ submit scripts) --------------------------
# Allocation / account charged for the jobs (sbatch -A). Leave unset if your cluster has none.
# export SMBH_SLURM_ACCOUNT="<your-allocation>"
# Partition for production jobs (~1 day, one full node per job)
# export SMBH_SLURM_PARTITION="<long-partition>"
# Partition for short test jobs (<= 4 h)
# export SMBH_SLURM_PARTITION_TEST="<short-partition>"
